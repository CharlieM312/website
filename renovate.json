{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:monorepos",
    "group:recommended",
    "monorepo:jest",
    ":prHourlyLimit2",
    ":semanticCommitTypeAll(build)",
    "security:minimumReleaseAgeNpm",
    "workarounds:all"
  ],
  "minimumReleaseAge": "3 days",
  "prCreation": "not-pending",
  "prConcurrentLimit": 2,
  "dependencyDashboard": false,
  "configMigration": true,
  "postUpdateOptions": ["yarnDedupeHighest"],
  "internalChecksFilter": "strict",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchDepNames": ["zone.js", "typescript"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/^@angular/","/^angular-eslint/"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "groupName": "Angular ecosystem",
      "matchPackageNames": [
        "/^@angular/",
        "/^angular-eslint/"
      ]
    },
    {
      "groupName": "ESLint tooling",
      "matchPackageNames": ["eslint", "globals", "/^eslint-/"]
    }
  ]
}
